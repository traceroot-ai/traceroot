{
  "name": "@traceroot/mcp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "dotenv -e ../../.env -- vite-node --watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "parity": "vite-node scripts/parity.ts",
    "parity:mock": "vite-node scripts/parity-mock.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.13",
    "@modelcontextprotocol/hono": "2.0.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@traceroot-ai/tools": "workspace:*",
    "hono": "^4.12.25"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "dotenv-cli": "^11.0.0",
    "traceroot-cli": "0.6.1",
    "typescript": "^5.7.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.12"
  }
}
