{
  "name": "traceroot-worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "dev:billing": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "dev:detectors": "dotenv -e ../../.env -- tsx watch src/detector-main.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:billing": "node dist/index.js",
    "start:detectors": "node dist/detector-main.js",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "update:trigger": "dotenv -e ../../.env -- tsx src/updates/dev/trigger-cli.ts",
    "update:seed": "dotenv -e ../../.env -- tsx src/updates/dev/seed/cli.ts",
    "update:tick": "dotenv -e ../../.env -- tsx src/updates/dev/tick-cli.ts"
  },
  "dependencies": {
    "@daytonaio/sdk": "0.226.1",
    "@earendil-works/pi-ai": "0.80.3",
    "@opentelemetry/api": "^1.9.1",
    "@traceroot-ai/traceroot": "^0.2.0",
    "@traceroot/core": "workspace:*",
    "@traceroot/slack": "workspace:*",
    "bullmq": "^5.73.3",
    "ioredis": "^5.10.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.4",
    "stripe": "14.25.0"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.14",
    "@vitest/coverage-v8": "^4.1.12",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  }
}
