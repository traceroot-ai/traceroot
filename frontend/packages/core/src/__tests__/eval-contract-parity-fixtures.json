        "name": "missing_status",
        "payload": { "test_case_id": "case-1", "input": "x" }
      },
      {
        "name": "missing_input",
        "payload": { "test_case_id": "case-1", "status": "passed" }
      },
      {
        "name": "bad_status_enum",
        "payload": { "test_case_id": "case-1", "input": "x", "status": "kinda_passed" }
