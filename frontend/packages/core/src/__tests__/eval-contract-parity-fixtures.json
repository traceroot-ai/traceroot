      },
      {
        "name": "minimal",
        "payload": { "test_case_id": "case-5", "input": "where is my order", "status": "passed" }
      },
      {
        "name": "with_duration_cost_and_typed_scores",
        "payload": {
          "test_case_id": "case-6",
          "input": "q",
          "baseline_output": "old",
          "status": "passed",
          "duration_ms": 1200,
