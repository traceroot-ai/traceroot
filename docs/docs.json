{
  "$schema": "https://mintlify.com/docs.json",
  "name": "traceroot",
  "theme": "mint",
  "appearance": {
    "default": "light",
    "strict": true
  },
  "thumbnails": {
    "appearance": "light",
    "background": "/images/og-background.png"
  },
  "colors": {
    "primary": "#0f766e",
    "light": "#5ed4cd",
    "dark": "#0f827d"
  },
  "rounded": "default",
  "layout": {
    "wide": true
  },
  "favicon": "/logo/favicon.png",
  "logo": {
    "light": "/brand/logo-light.svg",
    "dark": "/brand/logo-light.svg",
    "href": "https://traceroot.ai",
    "size": 36
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "redirects": [
    {
      "source": "/detectors/get-started",
      "destination": "/detectors/introduction#how-to-create-a-detector"
    },
    {
      "source": "/detectors/notifications",
      "destination": "/detectors/introduction#notifications"
    },
    {
      "source": "/detectors/alerts",
      "destination": "/detectors/introduction#notifications"
    },
    {
      "source": "/alerts/introduction",
      "destination": "/alerts/overview"
    },
    {
      "source": "/alerts/get-started",
      "destination": "/alerts/overview#how-to-create-an-alert"
    },
    {
      "source": "/alerts/slack",
      "destination": "/alerts/overview#slack-notifications"
    }
  ],
  "search": {
    "ai": true
  },
  "navbar": {
    "links": [
      {
        "label": "Examples",
        "href": "https://github.com/traceroot-ai/traceroot/tree/main/examples"
      },
      {
        "label": "traceroot Cloud",
        "href": "https://app.traceroot.ai"
      }
    ]
  },
  "navigation": {
    "tabs": [
