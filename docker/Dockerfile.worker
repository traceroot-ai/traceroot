# docker/Dockerfile.worker
FROM python:3.12-slim AS builder

WORKDIR /app
RUN pip install uv

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY backend ./backend

FROM python:3.12-slim AS runner

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/backend ./backend

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app/backend"

WORKDIR /app/backend

# `-B` runs the embedded beat scheduler in-process so the periodic tasks in
# `celery_app.beat_schedule` (the eval-result cost backfill, H7) actually fire.
# Safe with the default single worker replica; the backfill is idempotent, so even if
# workers are ever scaled >1 (embedded beat would then tick per replica) the duplicate
# runs are harmless — move to a dedicated `celery ... beat` process if that scale arrives.
CMD ["celery", "-A", "worker.celery_app", "worker", "--beat", "--loglevel=info"]
