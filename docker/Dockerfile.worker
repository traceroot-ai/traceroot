# docker/Dockerfile.worker
FROM python:3.12-slim AS builder

WORKDIR /app
RUN pip install uv

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY backend ./backend

FROM python:3.12-slim AS runner

# Pick up Debian security updates published after the base image was built, and
# drop the system pip: the app runs from the copied virtualenv and never installs.
RUN apt-get update && apt-get upgrade -y --no-install-recommends && rm -rf /var/lib/apt/lists/* && \
    python -m pip uninstall -y pip

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/backend ./backend

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app/backend"

WORKDIR /app/backend

# `--beat` runs the embedded beat scheduler in-process so the periodic tasks in
# `celery_app.beat_schedule` (the eval-result cost backfill) actually fire.
# `--schedule` puts beat's PersistentScheduler state under /tmp, which is writable even
# when the container root FS is read-only (a plain `celerybeat-schedule` in the CWD would
# crash beat on a hardened/ephemeral image).
# Safe with the default single worker replica; the backfill is idempotent, so even if
# workers are ever scaled >1 (embedded beat would then tick per replica) the duplicate
# runs are harmless — move to a dedicated single `celery ... beat` process (or a
# leader-locked tick) before scaling workers horizontally.
CMD ["celery", "-A", "worker.celery_app", "worker", "--beat", \
     "--schedule", "/tmp/celerybeat-schedule", "--loglevel=info"]
