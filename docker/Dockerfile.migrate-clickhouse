# docker/Dockerfile.migrate-clickhouse
# Lightweight image for running goose ClickHouse migrations.
FROM golang:1.27-alpine AS build
# Every caller runs goose with the ClickHouse driver only, so build it with the
# other drivers left out: their dependencies (x/net, x/crypto and ~40 more) only
# add scanner findings. `go get -u` then raises goose's remaining dependencies
# to their latest minor/patch releases, so each rebuild picks up upstream fixes
# without hand-pinned overrides. `go install pkg@ver` ignores both, hence the
# throwaway module. CI runs the real migrations through this image.
WORKDIR /src
RUN go mod init goose-build \
 && go get -u github.com/pressly/goose/v3/cmd/goose@v3.28.0 \
 && CGO_ENABLED=0 go build \
      -tags 'no_postgres no_mysql no_sqlite3 no_mssql no_azuresql no_vertica no_ydb no_libsql' \
      -o /go/bin/goose github.com/pressly/goose/v3/cmd/goose

FROM alpine:3.24
RUN apk upgrade --no-cache
COPY --from=build /go/bin/goose /usr/local/bin/goose
COPY backend/db/clickhouse/migrations /migrations

ENTRYPOINT ["goose", "-dir", "/migrations", "clickhouse"]
