# docker/Dockerfile.migrate-clickhouse
# Lightweight image for running goose ClickHouse migrations.
FROM golang:1.27-alpine AS build
# goose v3.28.0 (the latest release) pins dependencies that Amazon Inspector
# reports as vulnerable: golang.org/x/crypto, x/net, andybalholm/brotli and
# klauspost/compress. `go install pkg@ver` ignores version overrides, so build
# goose inside a throwaway module that raises them. Drop each override once a
# goose release requires that version.
WORKDIR /src
RUN go mod init goose-build \
 && go get github.com/pressly/goose/v3/cmd/goose@v3.28.0 \
           golang.org/x/crypto@v0.58.0 \
           golang.org/x/net@v0.62.0 \
           github.com/andybalholm/brotli@v1.2.7 \
           github.com/klauspost/compress@v1.20.2 \
 && CGO_ENABLED=0 go build -o /go/bin/goose github.com/pressly/goose/v3/cmd/goose

FROM alpine:3.24
RUN apk upgrade --no-cache
COPY --from=build /go/bin/goose /usr/local/bin/goose
COPY backend/db/clickhouse/migrations /migrations

ENTRYPOINT ["goose", "-dir", "/migrations", "clickhouse"]
