# docker/Dockerfile.migrate-clickhouse
# Lightweight image for running goose ClickHouse migrations.
FROM golang:1.27-alpine AS build
# goose and every dependency are pinned in docker/goose/go.mod and go.sum, which
# Dependabot keeps current, so each version is reviewed and the build is
# reproducible. Every caller runs goose with the ClickHouse driver only, so build
# it with the other drivers left out: their dependencies (x/net, x/crypto and
# ~40 more) stay in go.mod, which is tidied across all build tags, but never
# reach the binary.
WORKDIR /src
COPY docker/goose/go.mod docker/goose/go.sum ./
RUN go mod download \
 && CGO_ENABLED=0 go build -mod=readonly \
      -tags 'no_postgres no_mysql no_sqlite3 no_mssql no_azuresql no_vertica no_ydb no_libsql' \
      -o /go/bin/goose github.com/pressly/goose/v3/cmd/goose

FROM alpine:3.24
RUN apk upgrade --no-cache
COPY --from=build /go/bin/goose /usr/local/bin/goose
COPY backend/db/clickhouse/migrations /migrations

ENTRYPOINT ["goose", "-dir", "/migrations", "clickhouse"]
